# Database configuration
# Local development default. Set a managed database URL in production.
DATABASE_URL=mysql+pymysql://root:Saurav@17@localhost:3306/gehu_safety_db

# Security & JWT
# Required: generate a unique value with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=LCf00KxRVwvbpcVKL2up5h00oAlBRcY88DHs1g3zRq31xBNuZIDsh1XhaIruRdj3
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Campus Map Scope (GEHU Clement Town Campus)
MAP_CENTER_LAT=30.2675
MAP_CENTER_LNG=77.9959
MAP_BOUNDS_RADIUS_KM=2.0
JOURNEY_CHECKIN_GRACE_MINUTES=15

# SOS Configuration
SOS_CONFIRMATION_WINDOW_SECONDS=8

# Notification Service
# Set true only after configuring real SMTP delivery. False means SOS emails are not sent.
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Optional one-time admin setup. Set all three for one startup, then remove them.
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
