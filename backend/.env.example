# Database configuration
# MySQL format: mysql+pymysql://<user>:<password>@localhost:3306/gehu_safety_db
# SQLite fallback (zero-config local run): sqlite:///./gehu_safety.db
DATABASE_URL=mysql+pymysql://your_db_user:your_db_password@localhost:3306/gehu_safety_db

# Security & JWT
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_BASE64_SECRET_MIN_256_BITS_FOR_HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Campus Map Scope (GEHU Clement Town Campus)
MAP_CENTER_LAT=30.2675
MAP_CENTER_LNG=77.9959
MAP_BOUNDS_RADIUS_KM=2.0
JOURNEY_CHECKIN_GRACE_MINUTES=15

# SOS Configuration
SOS_CONFIRMATION_WINDOW_SECONDS=8

# Notification Service
# Set to true and configure SMTP to send real emails; false logs to database and console as simulation
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
